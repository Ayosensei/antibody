# Dependencies
node_modules/

# Environment files (never commit real credentials)
.env
.env.*
!.env.example

# Next.js build output
.next/
out/
dist/
build/

# Traces and logs (keep directory tracked with .gitkeep)
logs/*.jsonl
logs/*.log
!logs/.gitkeep

# Reports output
reports/*.json
!reports/.gitkeep

# Memory storage
data/memory/

# Security and certificates
*.pem
*.key

# Testing
coverage/

# OS files
.DS_Store
Thumbs.db
*.tsbuildinfo

# Scratch and temporary spike directories
scratch/
