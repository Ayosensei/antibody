# --- Run mode ---
SAMPLE_MODE=true
LLM_PROVIDER=meterless
LOG_LEVEL=info
LOG_DIR=./logs
CANARY_KEY=

# --- Meterless Nightshift (primary model provider) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_MODEL_REASONING=
METERLESS_MODEL_FAST=
METERLESS_APP_ID=antibody

# --- NVIDIA direct (fallback only) ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
MODEL_REASONING=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Zetaris ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_TIMEOUT_SECONDS=20

# --- Limits ---
MAX_RETRIES=2
ATTACK_TRIALS=1
CONCURRENCY=4
RUN_MAX_LLM_CALLS=400
RUN_MAX_SECONDS=420
TARGET_MAX_STEPS=8
TARGET_MAX_TOKENS=4000

# --- Ports ---
API_PORT=8000
UI_PORT=3100
